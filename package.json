{
  "name": "auto-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch src/server/main.ts",
    "start": "node --env-file-if-exists=.env dist/server/main.js --serve-web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.server.json && vite build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "node --env-file-if-exists=.env.migrate scripts/migrate.ts",
    "auth:create-user": "node --env-file-if-exists=.env.migrate scripts/create-local-account.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run tests/integration --no-file-parallelism",
    "test:e2e": "node --env-file-if-exists=.env.test node_modules/@playwright/test/cli.js test",
    "security:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.12",
    "@inquirer/password": "^5.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.15.0",
    "prisma": "7.10.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
