// PostgreSQL DDL is managed by database/migrations, including CHECK constraints and partial indexes.
generator client {
  provider            = "prisma-client"
  output              = "../src/server/generated/prisma"
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auto_finance"]
}

model Account {
  workspaceId         String                @map("workspace_id") @db.Uuid
  id                  String                @db.Uuid
  holderId            String                @map("holder_id") @db.Uuid
  name                String
  kind                String
  openingBalanceCents BigInt                @map("opening_balance_cents")
  openingDate         DateTime              @map("opening_date") @db.Date
  includeInBalance    Boolean               @map("include_in_balance")
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  holder              Holder                @relation(fields: [workspaceId, holderId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  cards               Card[]
  ledgerEntries       LedgerEntry[]
  adjustments         FinancialAdjustment[] @relation("OriginAccount")
  incomingAdjustments FinancialAdjustment[] @relation("DestinationAccount")
  importBatches       ImportBatch[]

  @@id([workspaceId, id])
  @@map("accounts")
  @@schema("auto_finance")
}

model AuthSession {
  tokenHash Bytes    @id @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "auth_sessions_expiry_idx")
  @@index([userId], map: "auth_sessions_user_idx")
  @@map("auth_sessions")
  @@schema("auto_finance")
}

model Card {
  workspaceId      String                @map("workspace_id") @db.Uuid
  id               String                @db.Uuid
  holderId         String                @map("holder_id") @db.Uuid
  paymentAccountId String?               @map("payment_account_id") @db.Uuid
  name             String
  lastFour         String?               @map("last_four")
  limitCents       BigInt                @map("limit_cents")
  closingDay       Int                   @map("closing_day")
  dueDay           Int                   @map("due_day")
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  holder           Holder                @relation(fields: [workspaceId, holderId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  paymentAccount   Account?              @relation(fields: [workspaceId, paymentAccountId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  ledgerEntries    LedgerEntry[]
  plans            CardInstallmentPlan[]
  adjustments      FinancialAdjustment[]
  importBatches    ImportBatch[]

  @@id([workspaceId, id])
  @@map("cards")
  @@schema("auto_finance")
}

model Holder {
  workspaceId String    @map("workspace_id") @db.Uuid
  id          String    @db.Uuid
  name        String
  accounts    Account[]
  cards       Card[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([workspaceId, id])
  @@map("holders")
  @@schema("auto_finance")
}

model LedgerEntry {
  workspaceId          String                @map("workspace_id") @db.Uuid
  id                   String                @db.Uuid
  accountId            String?               @map("account_id") @db.Uuid
  cardId               String?               @map("card_id") @db.Uuid
  kind                 String
  description          String
  category             String?
  tags                 String[]              @default([])
  amountCents          BigInt                @map("amount_cents")
  occurredOn           DateTime              @map("occurred_on") @db.Date
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  account              Account?              @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  card                 Card?                 @relation(fields: [workspaceId, cardId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  financialAdjustments FinancialAdjustment[]
  importRows           ImportRow[]

  @@id([workspaceId, id])
  @@index([workspaceId, occurredOn(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "ledger_entries_workspace_order_idx")
  @@map("ledger_entries")
  @@schema("auto_finance")
}

model PasswordCredential {
  userId       String @id @map("user_id") @db.Uuid
  passwordHash String @map("password_hash")
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("password_credentials")
  @@schema("auto_finance")
}

model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username           String              @unique
  displayName        String              @map("display_name")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  authSessions       AuthSession[]
  passwordCredential PasswordCredential?
  workspaceMembers   WorkspaceMember[]

  @@map("users")
  @@schema("auto_finance")
}

model WorkspaceMember {
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onUpdate: NoAction)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([workspaceId, userId])
  @@index([userId], map: "workspace_members_user_idx")
  @@map("workspace_members")
  @@schema("auto_finance")
}

model Workspace {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  accounts         Account[]
  cards            Card[]
  holders          Holder[]
  ledgerEntries    LedgerEntry[]
  workspaceMembers WorkspaceMember[]
  plans            CardInstallmentPlan[]
  adjustments      FinancialAdjustment[]
  importBatches    ImportBatch[]

  @@map("workspaces")
  @@schema("auto_finance")
}

model CardInstallmentPlan {
  workspaceId      String                @map("workspace_id") @db.Uuid
  id               String                @db.Uuid
  cardId           String                @map("card_id") @db.Uuid
  description      String
  totalCents       BigInt                @map("total_cents")
  installmentCount Int                   @map("installment_count")
  purchasedOn      DateTime              @map("purchased_on") @db.Date
  firstCycle       DateTime              @map("first_cycle") @db.Date
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  card             Card                  @relation(fields: [workspaceId, cardId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  refunds          FinancialAdjustment[]

  @@id([workspaceId, id])
  @@index([workspaceId, cardId, firstCycle], map: "card_installment_plans_card_idx")
  @@map("card_installment_plans")
  @@schema("auto_finance")
}

model FinancialAdjustment {
  workspaceId   String               @map("workspace_id") @db.Uuid
  id            String               @db.Uuid
  kind          String
  amountCents   BigInt               @map("amount_cents")
  occurredOn    DateTime             @map("occurred_on") @db.Date
  description   String
  cardId        String?              @map("card_id") @db.Uuid
  cycleMonth    DateTime?            @map("cycle_month") @db.Date
  accountId     String?              @map("account_id") @db.Uuid
  destinationId String?              @map("destination_id") @db.Uuid
  purchaseId    String?              @map("purchase_id") @db.Uuid
  planId        String?              @map("plan_id") @db.Uuid
  paymentId     String?              @map("payment_id") @db.Uuid
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  card          Card?                @relation(fields: [workspaceId, cardId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  account       Account?             @relation("OriginAccount", fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  destination   Account?             @relation("DestinationAccount", fields: [workspaceId, destinationId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  purchase      LedgerEntry?         @relation(fields: [workspaceId, purchaseId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  plan          CardInstallmentPlan? @relation(fields: [workspaceId, planId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  payment       FinancialAdjustment? @relation("PaymentReversal", fields: [workspaceId, paymentId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  reversal      FinancialAdjustment? @relation("PaymentReversal")
  importRows    ImportRow[]

  @@id([workspaceId, id])
  @@unique([workspaceId, paymentId])
  @@index([workspaceId, cardId, cycleMonth], map: "financial_adjustments_card_cycle_idx")
  @@index([workspaceId, accountId, occurredOn], map: "financial_adjustments_account_date_idx")
  @@index([workspaceId, destinationId, occurredOn], map: "financial_adjustments_destination_date_idx")
  @@map("financial_adjustments")
  @@schema("auto_finance")
}

model ImportBatch {
  workspaceId String      @map("workspace_id") @db.Uuid
  id          String      @db.Uuid
  accountId   String?     @map("account_id") @db.Uuid
  cardId      String?     @map("card_id") @db.Uuid
  digest      String
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account     Account?    @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  card        Card?       @relation(fields: [workspaceId, cardId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  rows        ImportRow[]

  @@id([workspaceId, id])
  @@index([workspaceId, createdAt(sort: Desc), id], map: "import_batches_workspace_date_idx")
  @@map("import_batches")
  @@schema("auto_finance")
}

model ImportRow {
  workspaceId    String               @map("workspace_id") @db.Uuid
  batchId        String               @map("batch_id") @db.Uuid
  line           Int
  status         String
  externalDigest String?              @map("external_digest")
  entryId        String?              @map("entry_id") @db.Uuid
  adjustmentId   String?              @map("adjustment_id") @db.Uuid
  batch          ImportBatch          @relation(fields: [workspaceId, batchId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction)
  entry          LedgerEntry?         @relation(fields: [workspaceId, entryId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  adjustment     FinancialAdjustment? @relation(fields: [workspaceId, adjustmentId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, batchId, line])
  @@map("import_rows")
  @@schema("auto_finance")
}
